---
interface Props {
  title: string
  description: string
  pubDate: Date
  slug: string
}

import FurryMark from './FurryMark.astro'
import { siteConfig } from '../config'

const { title, description, pubDate, slug } = Astro.props

const dateStr = pubDate.toLocaleDateString(siteConfig.site.contentDateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<a href={`/blog/${slug}`} class="theme-surface theme-card group block h-full p-7 no-underline">
  <article class="flex flex-col h-full gap-3">
    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[var(--color-surface-soft)] text-[var(--color-paw)]">
      <FurryMark class="h-5 w-5" />
    </span>
    <h3 class="text-xl font-bold text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-sky)]">{title}</h3>
    <p class="text-base text-[var(--color-muted)] line-clamp-3">{description}</p>
    <div class="flex items-center justify-between mt-auto">
      <time class="text-sm text-[var(--color-muted)]" datetime={pubDate.toISOString()}>
        {dateStr}
      </time>
      <span class="theme-hover-motion text-sm font-semibold text-[var(--color-paw)] transition-transform group-hover:translate-x-1">
        完整文章 &rarr;
      </span>
    </div>
  </article>
</a>
