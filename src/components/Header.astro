---
import { Menu, Search, SquareArrowOutUpRight, X } from '@lucide/astro'
import HeaderLink from './HeaderLink.astro'

const isHome = Astro.url.pathname === '/'
---

<header id="nav" data-transparent={isHome ? 'true' : 'false'} class={`${isHome ? 'fixed' : 'sticky'} top-0 left-0 w-full z-50 transition-all duration-300 ${isHome ? '' : 'bg-white'}`}>
  <nav class="relative flex items-center justify-between py-4 px-4 sm:px-8 lg:px-16">
    <a href="/" class="text-2xl font-medium italic no-underline transition-colors duration-300 {isHome ? 'text-white' : 'text-gray-950'}">
      Furnest
    </a>
    <div class="hidden md:flex gap-16">
      <HeaderLink href="/">首页</HeaderLink>
      <HeaderLink href="/blog">博客</HeaderLink>
      <HeaderLink href="/categories">分类</HeaderLink>
      <HeaderLink href="/archive">归档</HeaderLink>
      <HeaderLink href="/about">关于</HeaderLink>
    </div>
    <div class="flex gap-6 items-center">
      <a href="#" class="transition-colors duration-300 {isHome ? 'text-white hover:text-gray-300' : 'text-gray-950 hover:text-gray-600'}" aria-label="搜索">
        <Search size={24} />
      </a>
      <a href="#" class="transition-colors duration-300 {isHome ? 'text-white hover:text-gray-300' : 'text-gray-950 hover:text-gray-600'}" aria-label="外链">
        <SquareArrowOutUpRight size={24} />
      </a>
      <button id="menu-btn" class="md:hidden transition-colors duration-300 {isHome ? 'text-white hover:text-gray-300' : 'text-gray-950 hover:text-gray-600'}" aria-label="菜单">
        <Menu size={24} class="menu-icon-open" />
        <X size={24} class="menu-icon-close hidden" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="md:hidden max-h-0 opacity-0 overflow-hidden transition-all duration-300 ease-in-out bg-white border-t border-gray-100 shadow-lg">
    <div class="flex flex-col py-2">
      <a href="/" class="mobile-link block px-6 py-3 text-base font-light text-gray-950 no-underline hover:bg-gray-50">首页</a>
      <a href="/blog" class="mobile-link block px-6 py-3 text-base font-light text-gray-950 no-underline hover:bg-gray-50">博客</a>
      <a href="/categories" class="mobile-link block px-6 py-3 text-base font-light text-gray-950 no-underline hover:bg-gray-50">分类</a>
      <a href="/archive" class="mobile-link block px-6 py-3 text-base font-light text-gray-950 no-underline hover:bg-gray-50">归档</a>
      <a href="/about" class="mobile-link block px-6 py-3 text-base font-light text-gray-950 no-underline hover:bg-gray-50">关于</a>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('nav')
  const menuBtn = document.getElementById('menu-btn')
  const mobileMenu = document.getElementById('mobile-menu')
  const menuOpen = menuBtn.querySelector('.menu-icon-open')
  const menuClose = menuBtn.querySelector('.menu-icon-close')
  const mobileLinks = mobileMenu.querySelectorAll('.mobile-link')

  const pathname = window.location.pathname.replace(import.meta.env.BASE_URL, '')
  const subpath = pathname.match(/[^\/]+/g)
  mobileLinks.forEach(link => {
    const href = link.getAttribute('href')
    if (href === pathname || href === '/' + (subpath?.[0] || '')) {
      link.classList.add('font-bold', 'underline', 'underline-offset-4')
    }
  })

  let menuOpenState = false
  menuBtn.addEventListener('click', () => {
    menuOpenState = !menuOpenState
    if (menuOpenState) {
      mobileMenu.classList.add('max-h-96', 'opacity-100')
      mobileMenu.classList.remove('max-h-0', 'opacity-0')
      menuOpen.classList.add('hidden')
      menuClose.classList.remove('hidden')
    } else {
      mobileMenu.classList.add('max-h-0', 'opacity-0')
      mobileMenu.classList.remove('max-h-96', 'opacity-100')
      menuOpen.classList.remove('hidden')
      menuClose.classList.add('hidden')
    }
  })

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('max-h-0', 'opacity-0')
      mobileMenu.classList.remove('max-h-96', 'opacity-100')
      menuOpen.classList.remove('hidden')
      menuClose.classList.add('hidden')
      menuOpenState = false
    })
  })

  if (nav.dataset.transparent !== 'true') {
    nav.style.backgroundColor = 'white'
  } else {
    const navAnchors = nav.querySelector('nav').querySelectorAll('a')

    function updateNav() {
      const scrolled = window.scrollY > 10
      if (scrolled) {
        nav.style.backgroundColor = 'white'
        navAnchors.forEach(el => {
          el.style.color = '#030712'
        })
        menuBtn.style.color = '#030712'
      } else {
        nav.style.backgroundColor = 'transparent'
        navAnchors.forEach(el => {
          el.style.color = 'white'
        })
        menuBtn.style.color = 'white'
      }
    }

    window.addEventListener('scroll', updateNav, { passive: true })
    updateNav()
  }
</script>
