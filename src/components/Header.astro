---
import { Search, SquareArrowOutUpRight } from '@lucide/astro'
import HeaderLink from './HeaderLink.astro'

const isHome = Astro.url.pathname === '/'
---

<header id="nav" data-transparent={isHome ? 'true' : 'false'} class={`${isHome ? 'fixed' : 'sticky'} top-0 left-0 w-full z-50 rounded-b-lg transition-all duration-300 ${isHome ? '' : 'bg-white'}`}>
  <nav class="flex items-center justify-between py-4 px-16">
    <a href="/" class="text-2xl font-medium italic no-underline transition-colors duration-300 {isHome ? 'text-white' : 'text-gray-950'}">
      Furnest
    </a>
    <div class="hidden md:flex gap-16">
      <HeaderLink href="/">首页</HeaderLink>
      <HeaderLink href="/blog">博客</HeaderLink>
      <HeaderLink href="/categories">分类</HeaderLink>
      <HeaderLink href="/archive">归档</HeaderLink>
      <HeaderLink href="/about">关于</HeaderLink>
    </div>
    <div class="flex gap-6 items-center">
      <a href="#" class="transition-colors duration-300 {isHome ? 'text-white hover:text-gray-300' : 'text-gray-950 hover:text-gray-600'}" aria-label="搜索">
        <Search size={24} />
      </a>
      <a href="#" class="transition-colors duration-300 {isHome ? 'text-white hover:text-gray-300' : 'text-gray-950 hover:text-gray-600'}" aria-label="外链">
        <SquareArrowOutUpRight size={24} />
      </a>
    </div>
  </nav>
</header>

<script>
  const nav = document.getElementById('nav')
  if (nav.dataset.transparent !== 'true') {
    nav.style.backgroundColor = 'white'
  } else {
    const navAnchors = nav.querySelectorAll('a')

    function updateNav() {
      const scrolled = window.scrollY > 10
      if (scrolled) {
        nav.style.backgroundColor = 'white'
        navAnchors.forEach(el => {
          el.style.color = ''
          if (el.classList.contains('hover:text-gray-300')) {
            el.classList.remove('hover:text-gray-300')
            el.classList.add('hover:text-gray-600')
          }
        })
      } else {
        nav.style.backgroundColor = 'transparent'
        navAnchors.forEach(el => {
          el.style.color = 'white'
          if (el.classList.contains('hover:text-gray-600')) {
            el.classList.remove('hover:text-gray-600')
            el.classList.add('hover:text-gray-300')
          }
        })
      }
    }

    window.addEventListener('scroll', updateNav, { passive: true })
    updateNav()
  }
</script>
