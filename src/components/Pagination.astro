---
interface Props {
  prevUrl?: string
  nextUrl?: string
}

import { siteConfig } from '../config'

const { prevUrl, nextUrl } = Astro.props
---

{
  (prevUrl || nextUrl) && (
    <nav class="flex justify-center gap-8 mt-12">
      {prevUrl && (
        <a href={prevUrl} class="theme-surface theme-card rounded-full px-6 py-2 text-base font-light no-underline">
          &larr; {siteConfig.blog.previousLabel}
        </a>
      )}
      {nextUrl && (
        <a href={nextUrl} class="theme-surface theme-card rounded-full px-6 py-2 text-base font-light no-underline">
          {siteConfig.blog.nextLabel} &rarr;
        </a>
      )}
    </nav>
  )
}
