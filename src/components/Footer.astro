---
import FurryMark from './FurryMark.astro'
import WaveBoundary from './WaveBoundary.astro'
import { siteConfig } from '../config'

const today = new Date()
const footerGroups = siteConfig.footer.groups.filter((group) => group.links.length > 0)
const legalDetails = [...siteConfig.footer.registrationRecords, ...(siteConfig.footer.license ? [siteConfig.footer.license] : [])]
const avatarSrc = typeof siteConfig.brand.avatar === 'string' ? siteConfig.brand.avatar : siteConfig.brand.avatar.src
---

<footer class="relative mt-20 w-full bg-[var(--color-surface-soft)] md:mt-24">
  <WaveBoundary variant="footer" class="footer-boundary" />
  <div class="flex flex-col lg:flex-row gap-8 lg:gap-0 py-8 px-4 sm:px-8 lg:px-16 mx-auto max-w-[1920px]" data-motion="fade">
    {footerGroups.length > 0 && (
      <div class="flex-1 flex justify-center">
        <div class="w-full max-w-md grid grid-cols-3 gap-x-2 sm:gap-x-6">
          {footerGroups.map((group) => (
            <div class="min-w-0 flex flex-col gap-6">
              <span class="text-xl font-medium text-[var(--color-ink)]">| {group.title}</span>
              <div class="flex flex-col gap-4">
                {group.links.map((link) => (
                  <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined} class="text-base font-light text-[var(--color-ink)] no-underline hover:text-[var(--color-sky)] transition-colors">{link.label}</a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
    <div class="flex-1 flex justify-center">
      <div class="flex flex-col items-center gap-2">
        <div class="relative">
          <img
            src={avatarSrc}
            alt=""
            width="65"
            height="65"
            loading="lazy"
            decoding="async"
            class="w-[65px] h-[65px] rounded-2xl border-2 border-[var(--color-border)] object-cover shadow-[var(--shadow-soft)]"
          />
          <FurryMark class="absolute -right-3 -bottom-2 h-7 w-7 rotate-12 text-[var(--color-paw)]" />
        </div>
        <span class="text-xl font-medium text-[var(--color-ink)]">{siteConfig.brand.name}</span>
        <span class="text-base font-light text-[var(--color-muted)]">{siteConfig.brand.ownerTagline}</span>
      </div>
    </div>
  </div>

  <hr class="footer-line border-[var(--color-border)] w-full origin-left" data-motion="scale-x" />

  <div class="flex flex-col md:flex-row items-center gap-4 md:gap-0 py-6 px-4 sm:px-8 lg:px-16 mx-auto max-w-[1920px]" data-motion="fade">
    <div class="flex-1 flex justify-center">
      <div class="flex flex-col gap-1 text-center md:text-left">
        <span class="text-sm font-light text-[var(--color-muted)]">{siteConfig.footer.poweredBy} {siteConfig.brand.shortMark} {siteConfig.brand.version}</span>
        <span class="text-sm font-light text-[var(--color-muted)]">
          Copyright &copy; {siteConfig.brand.copyrightStartYear}-{today.getFullYear()} {siteConfig.brand.ownerName} All Rights Reserved.
        </span>
      </div>
    </div>
    {legalDetails.length > 0 && (
      <div class="flex-1 flex flex-wrap justify-center gap-x-4 gap-y-1">
        {legalDetails.map((detail) => <span class="text-sm font-light text-[var(--color-muted)]">{detail}</span>)}
      </div>
    )}
  </div>
</footer>
