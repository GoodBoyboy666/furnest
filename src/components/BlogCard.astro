---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  description: string
  pubDate: Date
  slug: string
  heroImage?: ImageMetadata
  category?: string
}

const { title, description, pubDate, slug, heroImage, category } = Astro.props

const dateStr = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<a href={`/blog/${slug}`} class:list={['block border border-gray-300 dark:border-gray-700 rounded-lg overflow-hidden hover:border-gray-400 dark:hover:border-gray-500 transition-colors no-underline opacity-0 translate-y-6']} data-animate>
  <article class="flex">
    {
      heroImage && (
        <div class="shrink-0 w-1/3 min-w-[120px]">
          <Image src={heroImage} alt="" class="w-full h-full object-cover" inferSize />
        </div>
      )
    }
    <div class="flex flex-col gap-3 p-8 flex-1 min-w-0">
      <h2 class="text-2xl font-bold text-gray-950 dark:text-gray-100">{title}</h2>
      <div class="flex items-center gap-3">
        <time class="text-sm font-light text-gray-500 dark:text-gray-400" datetime={pubDate.toISOString()}>
          {dateStr}
        </time>
        {category && (
          <span class="text-sm font-light text-gray-500 dark:text-gray-400">&middot; {category}</span>
        )}
      </div>
      <p class="text-base font-medium text-gray-600 dark:text-gray-400 line-clamp-2">{description}</p>
    </div>
  </article>
</a>
