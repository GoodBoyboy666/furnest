---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import FurryMark from './FurryMark.astro'
import { siteConfig } from '../config'

interface Props {
  title: string
  description: string
  pubDate: Date
  slug: string
  heroImage?: ImageMetadata
  category?: string
}

const { title, description, pubDate, slug, heroImage, category } = Astro.props

const dateStr = pubDate.toLocaleDateString(siteConfig.site.contentDateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})
---

<a href={`/blog/${slug}`} class:list={['theme-surface theme-card group block overflow-hidden no-underline opacity-0 translate-y-6']} data-animate>
  <article class="flex flex-col sm:flex-row">
    {
      heroImage && (
        <div class="h-44 shrink-0 overflow-hidden sm:h-auto sm:w-1/3 sm:min-w-[160px]">
          <Image src={heroImage} alt="" class="theme-hover-motion w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.025]" inferSize />
        </div>
      )
    }
    <div class="flex flex-col gap-3 p-8 flex-1 min-w-0">
      {category && <span class="flex w-fit items-center gap-1.5 rounded-full bg-[var(--color-surface-soft)] px-3 py-1 text-xs font-semibold text-[var(--color-paw)]"><FurryMark class="h-3.5 w-3.5" /> {category}</span>}
      <h2 class="text-2xl font-bold text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-sky)]">{title}</h2>
      <div class="flex items-center gap-3">
        <time class="text-sm font-light text-[var(--color-muted)]" datetime={pubDate.toISOString()}>
          {dateStr}
        </time>
      </div>
      <p class="text-base font-medium text-[var(--color-muted)] line-clamp-2">{description}</p>
    </div>
  </article>
</a>
