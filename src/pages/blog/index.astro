---
import { getCollection } from 'astro:content'
import BaseHead from '../../components/BaseHead.astro'
import BlogCard from '../../components/BlogCard.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header'
import Pagination from '../../components/Pagination.astro'
import FurryMark from '../../components/FurryMark.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts'

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
const pageSize = 5
const posts = allPosts.slice(0, pageSize)
const nextUrl = allPosts.length > pageSize ? '/blog/page/2' : undefined
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header client:load pathname={Astro.url.pathname} />
    <main class="flex-1">
      <section class="flex flex-col items-center py-20 px-8">
        <FurryMark variant="paw" class="blog-paw mb-3 h-10 w-10 text-[var(--color-paw)] opacity-0" />
        <span id="blog-label" class="theme-kicker text-2xl opacity-0 translate-y-5">BLOG ARTICLES</span>
        <h1 id="blog-title" class="theme-heading text-5xl font-medium mt-4 mb-8 opacity-0 translate-y-5">博客文章</h1>
        <hr id="blog-line" class="theme-rule border-t-2 w-full max-w-5xl mb-12 origin-left opacity-0" />

        <div id="blog-list" class="flex flex-col gap-8 max-w-5xl w-full">
          {
            posts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                slug={post.id}
                heroImage={post.data.heroImage}
                category={post.data.category}
              />
            ))
          }
        </div>
        <Pagination nextUrl={nextUrl} />
      </section>
    </main>
    <Footer />
  </body>
</html>

<script>
  import { initBlogListAnimations } from '../../scripts/blog-list-animations'
  document.addEventListener('astro:page-load', initBlogListAnimations)
</script>
