---
import { getCollection } from 'astro:content'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header'
import FurryMark from '../components/FurryMark.astro'
import { SITE_TITLE } from '../consts'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const grouped = new Map<string, typeof posts>()
for (const post of posts) {
  const cat = post.data.category || '未分类'
  if (!grouped.has(cat)) grouped.set(cat, [])
  grouped.get(cat)!.push(post)
}

const sortedGroups = Array.from(grouped.entries()).sort((a, b) => {
  if (a[0] === '未分类') return 1
  if (b[0] === '未分类') return -1
  return a[0].localeCompare(b[0])
})
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`分类 - ${SITE_TITLE}`} description="文章分类" />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header client:load pathname={Astro.url.pathname} />
    <main class="flex-1 py-20 px-8">
      <div class="max-w-3xl mx-auto">
        <div id="page-title" class="mb-10 border-l-4 border-[var(--color-paw)] pl-6 sm:pl-9">
          <span class="page-animate theme-kicker block text-2xl opacity-0">CATEGORIES</span>
          <h1 class="page-animate theme-heading text-5xl font-medium mt-3 opacity-0">分类</h1>
        </div>
        <div id="page-list" class="flex flex-col gap-12">
          {
            sortedGroups.map(([category, posts]) => (
              <section class="opacity-0">
                <h2 class="flex items-center gap-3 text-2xl font-bold text-[var(--color-ink)] mb-4">
                  <FurryMark variant="paw" class="h-6 w-6 text-[var(--color-paw)]" />
                  {category}
                  <span class="text-lg font-light text-[var(--color-muted)] ml-2">({posts.length}篇)</span>
                </h2>
                <hr class="theme-rule mb-4" />
                <div class="flex flex-col gap-3">
                  {posts.map((post) => {
                    const dateStr = post.data.pubDate.toLocaleDateString('zh-CN', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })
                    return (
                      <a href={`/blog/${post.id}`} class="theme-list-link flex items-baseline gap-4 px-3 py-2 -mx-3 no-underline">
                        <time class="text-sm font-light text-[var(--color-muted)] shrink-0">{dateStr}</time>
                        <span class="text-base font-medium truncate">{post.data.title}</span>
                      </a>
                    )
                  })}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<script>
  import { initListPageAnimations } from '../scripts/list-page-animations'
  document.addEventListener('astro:page-load', () => initListPageAnimations('page-title', 'page-list'))
</script>
