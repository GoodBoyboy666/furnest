---
import { getCollection } from 'astro:content'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header'
import FurryMark from '../components/FurryMark.astro'
import { siteConfig } from '../config'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const grouped = new Map<string, typeof posts>()
for (const post of posts) {
  const cat = post.data.category || siteConfig.pages.categories.uncategorizedLabel
  if (!grouped.has(cat)) grouped.set(cat, [])
  grouped.get(cat)!.push(post)
}

const sortedGroups = Array.from(grouped.entries()).sort((a, b) => {
  if (a[0] === siteConfig.pages.categories.uncategorizedLabel) return 1
  if (b[0] === siteConfig.pages.categories.uncategorizedLabel) return -1
  return a[0].localeCompare(b[0])
})
---

<!doctype html>
<html lang={siteConfig.site.locale}>
  <head>
    <BaseHead title={`${siteConfig.pages.categories.title} - ${siteConfig.site.title}`} description={siteConfig.pages.categories.description} />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header client:load pathname={Astro.url.pathname} />
    <main class="flex-1 py-20 px-8">
      <div class="max-w-3xl mx-auto">
        <div id="page-title" class="relative mb-10 border-l-4 border-transparent pl-6 sm:pl-9">
          <span class="page-accent absolute inset-y-0 -left-1 w-1 bg-[var(--color-paw)] opacity-0" aria-hidden="true"></span>
          <span class="page-animate theme-kicker block text-2xl opacity-0">{siteConfig.pages.categories.kicker}</span>
          <h1 class="page-animate theme-heading text-5xl font-medium mt-3 opacity-0">{siteConfig.pages.categories.title}</h1>
        </div>
        <div id="page-list" class="flex flex-col gap-12">
          {
            sortedGroups.length > 0 ? sortedGroups.map(([category, posts]) => (
              <section class="opacity-0">
                <h2 class="flex items-center gap-3 text-2xl font-bold text-[var(--color-ink)] mb-4">
                  <FurryMark variant="paw" class="h-6 w-6 text-[var(--color-paw)]" />
                  {category}
                  <span class="text-lg font-light text-[var(--color-muted)] ml-2">({posts.length}篇)</span>
                </h2>
                <hr class="theme-rule mb-4" />
                <div class="flex flex-col gap-3">
                  {posts.map((post) => {
                      const dateStr = post.data.pubDate.toLocaleDateString(siteConfig.site.contentDateLocale, {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })
                    return (
                      <a href={`/blog/${post.id}`} class="theme-list-link flex items-baseline gap-4 px-3 py-2 -mx-3 no-underline">
                        <time class="w-28 shrink-0 whitespace-nowrap text-sm font-light text-[var(--color-muted)]">{dateStr}</time>
                        <span class="text-base font-medium truncate">{post.data.title}</span>
                      </a>
                    )
                  })}
                </div>
              </section>
            )) : <p class="theme-muted text-lg">{siteConfig.pages.categories.emptyState}</p>
          }
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<script>
  import { initListPageAnimations } from '../scripts/list-page-animations'
  document.addEventListener('astro:page-load', () => initListPageAnimations('page-title', 'page-list'))
</script>
