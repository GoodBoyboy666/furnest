---
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header'
import { SITE_TITLE } from '../consts'
import friendsData from '../data/friends.json'

interface Friend {
  name: string
  url: string
  avatar: string
  description: string
}

const friends: Friend[] = friendsData
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`友情链接 - ${SITE_TITLE}`} description="友情链接" />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header client:load pathname={Astro.url.pathname} />
    <main class="flex-1 py-20 px-8">
      <div class="max-w-5xl mx-auto">
        <div id="page-title" class="mb-8">
          <span class="page-animate block text-2xl font-medium text-gray-950 dark:text-gray-100 opacity-0">FRIENDS</span>
          <h1 class="page-animate text-5xl font-medium text-gray-950 dark:text-gray-100 mt-3 opacity-0">| 友情链接</h1>
        </div>
        <div id="page-list" class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          {
            friends.map((friend) => (
              <a
                href={friend.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex min-w-0 items-center gap-4 rounded-lg border border-gray-200 bg-white p-5 text-gray-950 no-underline opacity-0 transition-colors hover:border-gray-400 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gray-950 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:hover:border-gray-500 dark:hover:bg-gray-800 dark:focus-visible:outline-gray-100"
              >
                <span class="relative flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-gray-200 text-xl font-medium text-gray-700 dark:bg-gray-700 dark:text-gray-100">
                  <span aria-hidden="true">{friend.name.charAt(0)}</span>
                  <img
                    src={friend.avatar}
                    alt={friend.name}
                    class="friend-avatar absolute inset-0 h-full w-full object-cover"
                    loading="lazy"
                  />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-xl font-medium break-words">{friend.name}</span>
                  <span class="mt-1 block text-sm font-light leading-6 text-gray-600 break-words dark:text-gray-400">
                    {friend.description}
                  </span>
                </span>
                <span class="sr-only">（在新标签页中打开）</span>
              </a>
            ))
          }
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<script>
  import { initListPageAnimations } from '../scripts/list-page-animations'

  function initFriendAvatars() {
    document.querySelectorAll<HTMLImageElement>('.friend-avatar').forEach((avatar) => {
      if (avatar.dataset.fallbackInitialized === 'true') return
      avatar.dataset.fallbackInitialized = 'true'
      avatar.addEventListener('error', () => {
        avatar.hidden = true
      }, { once: true })
      if (avatar.complete && avatar.naturalWidth === 0) avatar.hidden = true
    })
  }

  document.addEventListener('astro:page-load', () => {
    initFriendAvatars()
    const friendList = document.getElementById('page-list')
    if (!friendList || friendList.dataset.animationInitialized === 'true') return
    friendList.dataset.animationInitialized = 'true'
    initListPageAnimations('page-title', 'page-list')
  })
</script>
