---
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header'
import FurryMark from '../components/FurryMark.astro'
import { siteConfig } from '../config'
import friendsData from '../data/friends.json'

interface Friend {
  name: string
  url: string
  avatar: string
  description: string
}

const friends: Friend[] = friendsData
---

<!doctype html>
<html lang={siteConfig.site.locale}>
  <head>
    <BaseHead title={`${siteConfig.pages.friends.title} - ${siteConfig.site.title}`} description={siteConfig.pages.friends.description} />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header client:load pathname={Astro.url.pathname} />
    <main class="flex-1 py-20 px-8">
      <div class="max-w-5xl mx-auto">
        <div id="page-title" class="mb-10 border-l-4 border-[var(--color-paw)] pl-6 sm:pl-9">
          <span class="page-animate theme-kicker block text-2xl opacity-0">{siteConfig.pages.friends.kicker}</span>
          <h1 class="page-animate theme-heading text-5xl font-medium mt-3 opacity-0">| {siteConfig.pages.friends.title}</h1>
        </div>
        <div id="page-list" class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          {
            friends.length > 0 ? friends.map((friend) => (
              <a
                href={friend.url}
                target="_blank"
                rel="noopener noreferrer"
                class="theme-surface theme-card group relative flex min-w-0 items-center gap-4 p-5 no-underline opacity-0"
              >
                <span class="relative flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-[var(--color-surface-soft)] text-xl font-medium text-[var(--color-fur)]">
                  <span aria-hidden="true">{friend.name.charAt(0)}</span>
                  <img
                    src={friend.avatar}
                    alt={friend.name}
                    class="friend-avatar absolute inset-0 h-full w-full object-cover"
                    loading="lazy"
                    onerror="this.remove()"
                  />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-xl font-medium break-words">{friend.name}</span>
                  <span class="mt-1 block text-sm font-light leading-6 text-[var(--color-muted)] break-words">
                    {friend.description}
                  </span>
                </span>
                <FurryMark variant="paw" class="theme-hover-motion h-7 w-7 shrink-0 text-[var(--color-paw)] opacity-60 transition-transform group-hover:rotate-12" />
                <span class="sr-only">（在新标签页中打开）</span>
              </a>
            )) : <p class="theme-muted col-span-full text-center text-lg">{siteConfig.pages.friends.emptyState}</p>
          }
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<script>
  import { initListPageAnimations } from '../scripts/list-page-animations'

  document.addEventListener('astro:page-load', () => {
    const friendList = document.getElementById('page-list')
    if (!friendList || friendList.dataset.animationInitialized === 'true') return
    friendList.dataset.animationInitialized = 'true'
    initListPageAnimations('page-title', 'page-list')
  })
</script>
